<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root_full"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Üst Satır: Aktif Hat Bilgisi + SIM Seçici (OTO / SIM 1 / SIM 2) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/tv_widget_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Aktif: SIM 1 • 5G"
            android:textColor="#F9FAFB"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_sim_auto"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/chip_active_bg"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="OTO"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_sim_1"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/chip_inactive_bg"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="SIM 1"
            android:textColor="#D1D5DB"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_sim_2"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:background="@drawable/chip_inactive_bg"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="SIM 2"
            android:textColor="#D1D5DB"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Alt Satır: 5G / 4.5G Hızlı Geçiş Butonları -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_switch_5g"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:background="@drawable/btn_5g_active_bg"
            android:gravity="center"
            android:text="5G"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_switch_45g"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:background="@drawable/btn_inactive_bg"
            android:gravity="center"
            android:text="4.5G (LTE)"
            android:textColor="#E5E7EB"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_switch_toggle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="5dp"
            android:layout_weight="1.15"
            android:background="@drawable/btn_inactive_bg"
            android:gravity="center"
            android:text="⇄ DEĞİŞTİR"
            android:textColor="#93C5FD"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_open_settings"
            android:layout_width="36dp"
            android:layout_height="match_parent"
            android:background="@drawable/btn_inactive_bg"
            android:gravity="center"
            android:text="⚙"
            android:textColor="#9CA3AF"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
