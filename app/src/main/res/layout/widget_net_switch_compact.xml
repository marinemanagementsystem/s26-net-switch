<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root_compact"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <!-- Sol Kısım: SIM Hedefini Değiştir (OTO / SIM 1 / SIM 2) -->
    <LinearLayout
        android:id="@+id/btn_compact_cycle_sim"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="6dp"
        android:layout_weight="0.95"
        android:background="@drawable/btn_inactive_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="4dp">

        <TextView
            android:id="@+id/tv_compact_sim_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OTO (Veri)"
            android:textColor="#93C5FD"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_compact_sim_active"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="SIM 1"
            android:textColor="#F9FAFB"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Sağ Kısım: Tek Tıkla 5G ⇄ 4.5G Değiştir -->
    <LinearLayout
        android:id="@+id/btn_compact_toggle"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.25"
        android:background="@drawable/btn_5g_active_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="4dp">

        <TextView
            android:id="@+id/tv_compact_net_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="5G AKTİF"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_compact_net_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⇄ 4.5G'ye Geç"
            android:textColor="#E0F2FE"
            android:textSize="10sp" />
    </LinearLayout>

</LinearLayout>
